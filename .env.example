# Better Auth - Configuration
BETTER_AUTH_SECRET=replace_with_a_random_secret

# Dashboard authentication (required; set distinct strong values)
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Gateway Configuration
AI_GATEWAY_BASE_URL=http://localhost:8080
AI_GATEWAY_API_KEY=your_api_key

# Payments and tracking
AUTUMN_SECRET_KEY=your_autumn_test_key

# Graytag renewal automation — manual page can be enabled without starting the daemon
RENEWAL_AUTOMATION_ENABLED=false
RENEWAL_AUTOMATION_LIVE=false
# Separate scheduler switch; keep false for administrator-confirmed manual batches
RENEWAL_AUTOMATION_DAEMON_ENABLED=false
RENEWAL_AUTOMATION_INTERVAL_MS=300000
# Stable non-secret actor label stored in review/coupon audit history
AIO_ADMIN_ACTOR=dashboard-admin
# Optional: defaults to data/renewal-automation-jobs.json
# RENEWAL_AUTOMATION_JOBS_PATH=/absolute/path/to/renewal-automation-jobs.json

# YouTube invite sales — opt-in safety switches; keep disabled until each workflow is reviewed
YOUTUBE_INVITE_SALES_ENABLED=false
YOUTUBE_INVITE_AUTO_MESSAGE_ENABLED=false
YOUTUBE_INVITE_PROVIDER_AUTOMATION_ENABLED=false
# After all existing YouTube posts are verified sold, create one five-seat group and five posts.
# Queue the next real family manager Google email in the dashboard first.
YOUTUBE_AUTO_LISTING_ENABLED=false
YOUTUBE_AUTO_LISTING_INTERVAL_MS=300000
# YOUTUBE_AUTO_LISTING_STATE_PATH=/absolute/persistent/path/youtube-auto-listings.json
# YOUTUBE_AUTO_LISTING_LOCK_PATH=/absolute/persistent/path/youtube-auto-listings.lock
# New YouTube purchase chat guide requires all three switches plus the sales session.
AUTO_REPLY_DAEMON_ENABLED=false
AUTO_REPLY_DAEMON_DRY_RUN=true
AUTO_REPLY_ENABLE_SEND=false
# Dedicated YouTube seller Jev replies. Pre-delivery checks run every minute; post-delivery checks every five minutes.
YOUTUBE_JEV_AUTO_REPLY_ENABLED=false
YOUTUBE_JEV_REPLY_INTERVAL_MS=60000
YOUTUBE_JEV_POST_DELIVERY_INTERVAL_MS=300000
# Buyer chat email -> Notion checklist. Requires a Notion integration with read, insert and update access to the database.
NOTION_API_TOKEN=
NOTION_INVITATION_DATA_SOURCE_ID=52e0fe4e-5f56-4fa1-8547-f2e89142b0db
NOTION_SLOT_LEDGER_DATA_SOURCE_ID=0162c5cb-60f8-414c-beeb-9ec78dd9a383
# Paragraph immediately above Invitation waitlist; updated from the ledger and occupied tracker rows.
NOTION_SLOT_SUMMARY_BLOCK_ID=3e5ff936-cc9b-8037-b082-c540e7640d9f
NOTION_INVITATION_EMAIL_IMPORT_ENABLED=false
# Partner checks Invited -> GrayTag delivery complete. Enable only after a dry run and a valid sales session.
NOTION_INVITATION_AUTO_DELIVERY_ENABLED=false
NOTION_INVITATION_INTERVAL_MS=60000
# GButs Spotify buyer chat -> private Notion checklist. Keep disabled until a seller API session is connected.
GBUTS_SPOTIFY_SYNC_ENABLED=false
GBUTS_SPOTIFY_AUTO_MESSAGE_ENABLED=false
GBUTS_API_TOKEN=
# Optional persistent session location; the dashboard's GButs connection stores only the API token, not the password.
# GBUTS_SESSION_PATH=/absolute/persistent/path/gbuts-session.json
GBUTS_SPOTIFY_POST_SEQ=15557
NOTION_SPOTIFY_DATA_SOURCE_ID=560bff3e-13e1-4c84-8352-0a91899d045c
GBUTS_SPOTIFY_SYNC_INTERVAL_MS=30000
# Set to the rollout time (ISO 8601) so old buyer replies do not receive a late acknowledgment.
# GBUTS_SPOTIFY_ACK_START_AT=2026-10-03T00:00:00Z
# GBUTS_SPOTIFY_MESSAGE_JOURNAL_PATH=/absolute/persistent/path/gbuts-spotify-messages.json
# Optional persistent paths outside release directories:
# NOTION_INVITATION_JOURNAL_PATH=/home/ubuntu/.hermes/hermes-agent/graytag-aio-manager-0606/data/notion-invitation-deliveries.json
# NOTION_INVITATION_LOCK_PATH=/home/ubuntu/.hermes/hermes-agent/graytag-aio-manager-0606/data/notion-invitation-deliveries.lock
# Optional: persistent idempotency/reconciliation journal; defaults to data/youtube-product-registrations.json
# YOUTUBE_PRODUCT_REGISTRATIONS_PATH=/absolute/path/to/youtube-product-registrations.json
# Optional: shared cross-store capacity lock; defaults to data/youtube-capacity.lock
# YOUTUBE_CAPACITY_LOCK_PATH=/absolute/path/to/youtube-capacity.lock
